# ── AapdaNetra-X Backend Environment Configuration ─────────────────────
#
# Copy this file to `.env` and fill in your values.
# All settings have safe defaults — the system runs in simulated mode
# without any environment variables set.

# ── Data Mode ──────────────────────────────────────────────────────────
# Controls whether the risk engine uses live external data or synthetic defaults.
#   "simulated" — (default) Phase 5D behavior, all hardcoded sensor values
#   "hybrid"    — live weather + water level when available, simulated fallback
#   "live"      — same as hybrid (full live requires all providers configured)
DATA_MODE=simulated

# ── OpenWeatherMap API ─────────────────────────────────────────────────
# Get a free API key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_LAT=28.6448
OPENWEATHERMAP_LON=77.2167

# ── Water Level Source ─────────────────────────────────────────────────
# Controls the water level data source.
#   "simulated" — uses hardcoded defaults (6.8m)
#   "manual"    — reads from water_level_override.json or env vars
#   "api"       — (future) CWC river gauge API
WATER_LEVEL_SOURCE=simulated

# To manually override water level (used when WATER_LEVEL_SOURCE=manual):
# WATER_LEVEL_OVERRIDE=7.2
# WATER_LEVEL_TREND_OVERRIDE=0.5

# ── Cache Configuration ───────────────────────────────────────────────
# Time-to-live for cached weather and water level API responses (in seconds)
WEATHER_CACHE_TTL=300
WATER_LEVEL_CACHE_TTL=60
CWC_STATION_ID=EXAMPLE-STN-YAMUNA-01

# ── Phase 6.4 Contextual Data Providers ────────────────────────────────
# Traffic API Configuration
TRAFFIC_API_KEY=
TRAFFIC_API_URL=
TRAFFIC_CACHE_TTL=180

# Population Dataset Configuration (e.g. WorldPop 100m gridded GeoJSON)
POPULATION_DATASET_PATH=
POPULATION_CACHE_TTL=86400

# Critical Infrastructure Dataset Configuration (e.g. OSM critical asset JSON)
INFRASTRUCTURE_DATASET_PATH=
INFRASTRUCTURE_CACHE_TTL=86400

# ── Fallback Behavior ─────────────────────────────────────────────────
# When true, failed live API calls fall back to simulated defaults.
# When false, errors propagate (for debugging/monitoring).
ENABLE_FALLBACK=true

# ── Existing Settings ─────────────────────────────────────────────────
USE_SIMULATED_DATA=true
LOG_LEVEL=INFO
API_VERSION=0.1.0

# ── Phase 6.5A: PostgreSQL/PostGIS Foundation ─────────────────────────
# Controls whether the application uses PostgreSQL for persistence.
#   "disabled"  — (default) no DB initialization, pure in-memory behavior
#   "optional"  — attempt DB connection, continue without on failure
#   "required"  — DB must be available, failure is surfaced via /health
PERSISTENCE_MODE=disabled

# PostgreSQL connection settings (used when PERSISTENCE_MODE != disabled)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aapdanetra
POSTGRES_USER=aapdanetra
POSTGRES_PASSWORD=

# Direct database URL override (takes precedence over individual fields)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Connection pool & timeout tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_ECHO=false

# ── Phase 6.12: ML Pipeline ──────────────────────────────────────────────
# The risk prediction model (GradientBoostingRegressor) is currently trained
# on SYNTHETIC data generated by a domain-informed formula. The model's
# evaluation metrics reflect synthetic-data performance ONLY.
#
# To retrain the model:
#   python -m ml.pipeline.train_pipeline --version 1.1.0
#
# Model data status is automatically tracked in ml/models/model_metadata.json
# and exposed via GET /api/model-info and GET /health
#
# MODEL_DATA_STATUS values (read-only, derived from training data):
#   "synthetic"  — model trained on formula-generated synthetic data
#   "real"       — model trained on verified real-world labeled data
#   "hybrid"     — model trained on mixed synthetic + real data
#
# IMPORTANT: Do NOT present synthetic-trained model predictions as
# real-world validated risk assessments.
